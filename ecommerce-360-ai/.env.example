# Copy to .env and edit. NEVER commit .env.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

POSTGRES_PASSWORD=ecom_dev_password
AI_DB_PASSWORD=ai_readonly_dev_pw

# Used when running the backend outside Docker (db published on localhost:5432)
DATABASE_URL=postgresql+psycopg://ecom:ecom_dev_password@localhost:5432/ecommerce360
AI_DATABASE_URL=postgresql+psycopg://ai_readonly:ai_readonly_dev_pw@localhost:5432/ecommerce360

# Optional demo auth: if set, the API requires header X-API-Key (frontend: VITE_API_KEY)
APP_API_KEY=
RATE_LIMIT_PER_MINUTE=60
CURRENCY_SYMBOL=R$
